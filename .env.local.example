# ---- Pothole Shelter ----
# Account: syncaimain
# Copy to .env.local (gitignored) and fill in. Never commit the real file.

# --- Sanity (this project has its OWN Sanity account) ---
# CLI auth, used by sanity deploy / dataset import.
# VERIFY the exact variable name against current Sanity CLI docs before relying on it.
SANITY_AUTH_TOKEN=
SANITY_PROJECT_ID=
SANITY_DATASET=production
# Write token for ingest; read token only if the dataset is not public.
SANITY_API_WRITE_TOKEN=
SANITY_API_READ_TOKEN=

# --- Vercel (this project has its OWN Vercel account) ---
VERCEL_TOKEN=
VERCEL_ORG_ID=
VERCEL_PROJECT_ID=

# --- Model provider ---
ANTHROPIC_API_KEY=

# --- NYC Open Data / Socrata ---
# Free app token, raises rate limits. Sent in the X-App-Token header.
SOCRATA_APP_TOKEN=
